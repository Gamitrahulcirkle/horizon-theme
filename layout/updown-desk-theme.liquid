      </div>
    {% endif %}    

    {% comment %} Add stictly color matched product settings to use in theme-global.js using id="strict_product_option" {% endcomment %}
    {% assign strict_product_handles = settings.stict_clr_product %}
    {% if strict_product_handles != blank %}
      <script type="text/javascript" id="strict_product_option">
        [
          {% for product in strict_product_handles %}
            {{ product | json }}{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      </script>
   {% endif %}

